# Guardian runs without any keys: the default mode replays recorded LLM runs from evidence/runs.
#   replay - recorded responses (default, no keys needed)
#   stub   - deterministic stub responses (tests)
#   record - live calls, responses are saved for replay
#   live   - live calls
GUARDIAN_LLM_MODE=replay

# Hard cap on spend for our own keys, enforced by the kernel LLM gateway.
GUARDIAN_BUDGET_USD=25

# Models, prices and the names of the key variables live in config/models.yaml.
# Keys and endpoints go only here (or in the environment), never into the repository.
ANTHROPIC_API_KEY=
# Optional: an Anthropic compatible gateway instead of the public API.
ANTHROPIC_BASE_URL=
# Optional OpenAI compatible provider for the model ladder and the multi model red-team (DeepSeek, Qwen).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Optional overrides of config/models.yaml, per level (L1, L2, L3). Empty means "use the file".
# GUARDIAN_MODELS_FILE=config/models.yaml
GUARDIAN_MODEL_L1=
GUARDIAN_MODEL_L2=
GUARDIAN_MODEL_L3=
# GUARDIAN_PROVIDER_L1=openai_compat
# GUARDIAN_PRICE_L1_IN=0.3
# GUARDIAN_PRICE_L1_OUT=1.2
# GUARDIAN_EFFORT_L1=false
# Short form: GUARDIAN_MODEL_L1=openai_compat:deepseek-chat:0.3:1.2

# Our earlier prototype (guardian/), off without a key.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# GUARDIAN_LLM_MODEL=

# Database. docker compose sets this itself; without it the journal and mandates live in memory.
# DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian
# Password of the PostgreSQL container in docker compose (default guardian).
# POSTGRES_PASSWORD=

# Kill switch for /operator endpoints
GUARDIAN_OPERATOR_TOKEN=change-me
GUARDIAN_TASK_BUDGET_USD=0.50

# Investing (C11): sim is the sandbox broker; alpaca is Alpaca paper trading.
GUARDIAN_BROKER=sim
# Alpaca paper keys (or put "KEY_ID SECRET" into ~/.alpaca_keys). Never commit them.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
