# Guardian runs without any keys: the default mode replays recorded LLM runs from evidence/runs.
#   replay - recorded responses (default, no keys needed)
#   stub   - deterministic stub responses (tests)
#   record - live calls, responses are saved for replay
#   live   - live calls
GUARDIAN_LLM_MODE=replay

# Hard cap on spend for our own keys, enforced by the kernel LLM gateway.
GUARDIAN_TOKEN_BUDGET_RUB=2000

# Live/record modes only. Keys are read from the environment, never from the repository.
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible providers for the model ladder and multi-model red-team (DeepSeek, Qwen).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Database. docker compose sets this automatically; without it the kernel uses SQLite under /tmp.
DATABASE_URL=postgresql://guardian:guardian@db:5432/guardian

# Kill switch for /operator endpoints
GUARDIAN_OPERATOR_TOKEN=change-me
GUARDIAN_USD_RUB=100
GUARDIAN_TASK_BUDGET_RUB=50
